# SONARIA: さくらのレンタルサーバ（Apache）用
# docs/decisions/0001-phase1-static-site.md

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # トップページ（/）だけを言語別ページへ振り分ける。
  # 1. 本人が選んだ言語（Cookie: sonaria_lang）を最優先
  RewriteCond %{HTTP_COOKIE} (^|;\s*)sonaria_lang=ja(;|$)
  RewriteRule ^$ /ja/ [R=302,L]
  RewriteCond %{HTTP_COOKIE} (^|;\s*)sonaria_lang=en(;|$)
  RewriteRule ^$ /en/ [R=302,L]

  # 2. ブラウザの第一言語が日本語なら /ja/、それ以外は /en/
  RewriteCond %{HTTP:Accept-Language} ^ja [NC]
  RewriteRule ^$ /ja/ [R=302,L]
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  # 振り分け結果が Cookie と言語設定で変わることをキャッシュに伝える
  <If "%{REQUEST_URI} == '/'">
    Header append Vary "Accept-Language, Cookie"
  </If>
</IfModule>
