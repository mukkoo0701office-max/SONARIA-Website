# 画面側（Next.js）の環境変数。ここに置くのは公開してよい値だけ。
# GitHub Pages のプレビューでは、リポジトリの Settings → Secrets and variables → Actions → Variables に同じ名前で設定する。

# Supabase のプロジェクト URL と公開キー（anon / publishable key）。秘密キー（service_role）は絶対に入れない
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile のサイトキー（任意・公開してよい値）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
