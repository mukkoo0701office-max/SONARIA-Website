# Edge Functions の環境変数（秘密情報）。本番は Supabase ダッシュボード → Edge Functions → Secrets に設定する。
# このファイルに実際の値を書いてコミットしないこと。
# SUPABASE_URL と SUPABASE_SERVICE_ROLE_KEY は Supabase が自動で設定する。

# 管理人への通知先メールアドレス（Resend のアカウントに登録したアドレス）
ADMIN_NOTIFY_EMAIL=
# 管理画面の URL（通知メールに載せる）
ADMIN_DASHBOARD_URL=https://mukkoo0701office-max.github.io/SONARIA-Website/admin/

# Resend の API キー（Sending access のみのキーを推奨）
RESEND_API_KEY=
# 送信元。独自ドメインを認証するまでは onboarding@resend.dev のまま
MAIL_FROM=SONARIA <onboarding@resend.dev>
# 申込者への受付確認メール。送信元ドメインを認証してから true にする
APPLICANT_EMAIL_ENABLED=false

# 受け付けるオリジン（カンマ区切り）。未設定だと全て許可されるので、本番では必ず設定する
ALLOWED_ORIGINS=https://mukkoo0701office-max.github.io

# 送信回数制限（1 時間あたり・送信元ごと）と、IP ハッシュ用のソルト（ランダムな文字列）
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_SALT=

# Cloudflare Turnstile（任意。設定すると CAPTCHA を必須にする）
TURNSTILE_SECRET_KEY=
